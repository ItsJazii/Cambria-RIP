---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceChip from "../components/SourceChip.astro";
import Embers from "../components/Embers.astro";
import { SITE } from "../lib/site";

const RANK_VAR: Record<string, string> = {
  Legend: "var(--accent-bright)",
  Notorious: "var(--cat-exploit)",
  Suspect: "var(--cat-economy)",
  Cleared: "var(--cat-token)",
};

const entries = (await getCollection("shame")).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const description = "The Wall of Shame - names, faces and receipts from Cambria's incidents.";

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0] ?? "")
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<BaseLayout title={`Wall of Shame | ${SITE.name}`} description={description}>
  <section class="relative overflow-hidden border-b border-[var(--line)]">
    <Embers />
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="ui-text text-xs text-[var(--muted)]">Nominations open</p>
      <h1 class="display-text mt-4 text-5xl leading-none sm:text-6xl">
        Wall of <span class="glow-text">Shame</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-[var(--ink-soft)]">
        {description}
      </p>
      <button type="button" id="report-open" class="glow-button mt-7 rounded-md px-5 py-2.5 text-sm">
        Report someone
      </button>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    {
      rendered.length === 0 ? (
        <div class="panel flex flex-col items-center gap-4 px-6 py-16 text-center">
          <div class="flex h-20 w-20 items-center justify-center rounded-full border border-dashed border-[var(--line)] text-3xl text-[var(--muted)]">
            ?
          </div>
          <h2 class="display-text text-3xl leading-none">The wall is empty</h2>
          <p class="max-w-md text-sm leading-relaxed text-[var(--ink-soft)]">
            Nobody has been inducted yet. Add a name and a profile picture and they will show up
            here.
          </p>
        </div>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {rendered.map(({ entry, Content }) => (
            <li class="panel flex flex-col items-center p-6 text-center">
              {entry.data.avatar ? (
                <img
                  src={entry.data.avatar}
                  alt={entry.data.name}
                  loading="lazy"
                  class="h-24 w-24 rounded-full border border-[var(--line)] object-cover"
                />
              ) : (
                <div class="display-text flex h-24 w-24 items-center justify-center rounded-full border border-[var(--line)] bg-[var(--surface-2)] text-2xl text-[var(--muted)]">
                  {initials(entry.data.name)}
                </div>
              )}

              <h2 class="display-text mt-4 text-2xl leading-none">{entry.data.name}</h2>
              {entry.data.handle && (
                <p class="ui-text mt-2 text-[11px] text-[var(--accent)]">{entry.data.handle}</p>
              )}

              <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
                <span
                  class="category-chip ui-text rounded px-2 py-1 text-[10px] leading-none"
                  style={`--cat: ${RANK_VAR[entry.data.rank]}`}
                >
                  {entry.data.rank}
                </span>
                {entry.data.dateLabel && (
                  <span class="ui-text text-[11px] text-[var(--muted)]">{entry.data.dateLabel}</span>
                )}
              </div>

              {entry.data.charge && (
                <p class="mt-4 text-sm font-medium text-[var(--ink)]">{entry.data.charge}</p>
              )}

              <div class="prose-cambria mt-3 text-sm">
                <Content />
              </div>

              {entry.data.sources.length > 0 && (
                <div class="mt-4 flex flex-wrap justify-center gap-2">
                  {entry.data.sources.map((s) => (
                    <SourceChip label={s.label} url={s.url} />
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10 text-center">
      <button type="button" data-report-open class="source-chip ui-text rounded-md px-4 py-2.5 text-[11px]">
        Know someone who belongs here? Report them
      </button>
    </div>
  </section>

  <dialog
    id="report-dialog"
    class="panel m-auto w-[min(92vw,28rem)] p-0 text-[var(--ink)] backdrop:bg-black/70"
  >
    <form id="report-form" class="flex flex-col gap-4 p-6" novalidate>
      <div class="flex items-start justify-between gap-4">
        <h2 class="display-text text-3xl leading-none">Report someone</h2>
        <button type="button" data-report-close aria-label="Close" class="text-xl leading-none text-[var(--muted)] hover:text-[var(--ink)]">&times;</button>
      </div>
      <p class="text-xs leading-relaxed text-[var(--muted)]">
        Reports are reviewed by hand before anyone is added to the wall.
      </p>
      <label class="flex flex-col gap-1.5">
        <span class="ui-text text-[11px] text-[var(--ink-soft)]">Name</span>
        <input name="name" required maxlength="80" autocomplete="off" class="report-input" />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="ui-text text-[11px] text-[var(--ink-soft)]">What they did</span>
        <textarea name="offense" required maxlength="2000" rows="4" class="report-input resize-y"></textarea>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="ui-text text-[11px] text-[var(--ink-soft)]">Their Discord @username</span>
        <input name="discord" required maxlength="40" placeholder="@username" autocomplete="off" class="report-input" />
      </label>
      <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      <p id="report-status" class="min-h-[1.25rem] text-xs" role="status"></p>
      <button type="submit" class="glow-button rounded-md px-5 py-2.5 text-sm">Submit report</button>
    </form>
  </dialog>
</BaseLayout>

<style>
  .report-input {
    border: 1px solid var(--line-strong);
    background: var(--surface-2);
    color: var(--ink);
    border-radius: 0.375rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
  }
  .report-input:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>

<script>
  const dialog = document.getElementById("report-dialog") as HTMLDialogElement;
  const form = document.getElementById("report-form") as HTMLFormElement;
  const status = document.getElementById("report-status") as HTMLParagraphElement;
  const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  const setStatus = (text: string, ok = false) => {
    status.textContent = text;
    status.style.color = ok ? "var(--cat-token)" : "var(--cat-exploit)";
  };

  document.querySelectorAll("#report-open, [data-report-open]").forEach((btn) =>
    btn.addEventListener("click", () => {
      setStatus("");
      dialog.showModal();
    }),
  );
  dialog.querySelector("[data-report-close]")?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.name?.trim() || !data.offense?.trim() || !data.discord?.trim()) {
      setStatus("Fill in all three fields.");
      return;
    }
    submit.disabled = true;
    setStatus("Sending...", true);
    try {
      const res = await fetch("/api/report", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || "Something went wrong");
      form.reset();
      setStatus("Report received. Thanks.", true);
    } catch (err) {
      setStatus(err instanceof Error ? err.message : "Something went wrong");
    } finally {
      submit.disabled = false;
    }
  });
</script>
