---
import CategoryChip from "./CategoryChip.astro";
import SourceChip from "./SourceChip.astro";
import { CATEGORY_VAR } from "../lib/site";

interface Props {
  id: string;
  title: string;
  dateLabel: string;
  date: Date;
  category: string;
  summary: string;
  sources: { label: string; url: string }[];
}

const { id, title, dateLabel, date, category, summary, sources } = Astro.props;
---

<article
  class="timeline-entry relative py-8"
  data-category={category}
  data-date={date.toISOString()}
>
  <span
    class="absolute left-4 top-11 z-10 -translate-x-1/2 md:left-1/2"
    aria-hidden="true"
    style={`--cat: ${CATEGORY_VAR[category] ?? "var(--accent)"}`}
  >
    <svg viewBox="0 0 18 18" class="timeline-marker h-4 w-4">
      <circle cx="9" cy="9" r="5"></circle>
    </svg>
  </span>

  <div class="entry-card">
    <div class="entry-row flex flex-wrap items-center gap-2">
      <time class="ui-text text-xs text-[var(--muted)]" datetime={date.toISOString().slice(0, 10)}
        >{dateLabel}</time
      >
      <CategoryChip category={category} />
    </div>

    <h3 class="display-text mt-3 text-2xl leading-tight text-[var(--ink)] sm:text-3xl">
      <a href={`/events/${id}/`} class="transition-colors hover:text-[var(--accent-bright)]"
        >{title}</a
      >
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-[var(--ink-soft)]">{summary}</p>

    <div class="entry-row mt-4 flex flex-wrap gap-2">
      {sources.map((s) => <SourceChip label={s.label} url={s.url} />)}
    </div>

    <div class="entry-row mt-4 flex">
      <a
        href={`/events/${id}/`}
        class="ui-text text-xs text-[var(--accent)] transition-colors hover:text-[var(--accent-bright)]"
        >Read the full story &rarr;</a
      >
    </div>
  </div>
</article>
