---
interface Props {
  label: string;
  url: string;
}

const { label, url } = Astro.props;
const host = new URL(url).hostname.replace(/^www\./, "");
---

<a
  href={url}
  target="_blank"
  rel="noopener nofollow"
  class="source-chip inline-flex max-w-full items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs"
  title={`${label} - ${host}`}
>
  <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0 fill-current opacity-70" aria-hidden="true">
    <path
      d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3ZM5 5h5v2H6v11h11v-4h2v6H4V5h1Z"
    ></path>
  </svg>
  <span class="truncate">{label}</span>
</a>
