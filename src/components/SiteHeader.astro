---
import { getCollection } from "astro:content";
import { SITE } from "../lib/site";

const count = (await getCollection("events")).length;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--line)] bg-[rgba(11,10,9,0.82)] backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2">
      <span class="display-text text-2xl leading-none text-[var(--ink)]">Cambria</span>
      <span class="display-text glow-text text-2xl leading-none">.rip</span>
    </a>

    <span
      class="ui-text ml-2 hidden items-center gap-2 rounded-full border border-[var(--line)] px-3 py-1 text-xs text-[var(--ink-soft)] lg:inline-flex"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--cat-exploit)]"></span>
      {count} incidents logged
    </span>

    <nav class="ml-2 flex items-center gap-3" aria-label="Site sections">
      <a
        href="/"
        class="ui-text text-[11px] text-[var(--ink-soft)] transition-colors hover:text-[var(--accent-bright)]"
        >Timeline</a
      >
      <a
        href="/hall-of-shame.html"
        class="ui-text text-[11px] text-[var(--ink-soft)] transition-colors hover:text-[var(--accent-bright)]"
        >Hall of Shame</a
      >
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={SITE.x}
        target="_blank"
        rel="noopener"
        aria-label="Cambria on X"
        class="source-chip hidden h-9 w-9 items-center justify-center rounded-md sm:flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path
            d="M18.9 2H22l-7.1 8.1L23.2 22h-6.6l-5.2-6.8L5.5 22H2.4l7.6-8.7L1.2 2H8l4.7 6.2L18.9 2Zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20Z"
          ></path>
        </svg>
      </a>
      <a
        href={SITE.discord}
        target="_blank"
        rel="noopener"
        aria-label="Cambria Discord"
        class="source-chip hidden h-9 w-9 items-center justify-center rounded-md sm:flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path
            d="M19.6 5.3A16 16 0 0 0 15.7 4l-.3.5c1.4.4 2.5 1 3.5 1.7a13.6 13.6 0 0 0-11.8 0c1-.7 2.2-1.4 3.5-1.7L10.3 4a16 16 0 0 0-3.9 1.3C3.9 9 3.2 12.6 3.5 16.2A16 16 0 0 0 8.4 20l1-1.5c-.8-.3-1.6-.7-2.3-1.2l.6-.4a11.4 11.4 0 0 0 10.6 0l.6.4c-.7.5-1.5.9-2.4 1.2l1 1.5a16 16 0 0 0 5-3.8c.4-4.2-.6-7.8-2.9-10.9ZM9.3 14.3c-.9 0-1.7-.9-1.7-2s.8-2 1.7-2c1 0 1.8.9 1.7 2 0 1.1-.8 2-1.7 2Zm5.4 0c-1 0-1.7-.9-1.7-2s.8-2 1.7-2c1 0 1.7.9 1.7 2s-.7 2-1.7 2Z"
          ></path>
        </svg>
      </a>
      <a
        href="https://lobby.cambria.gg/"
        target="_blank"
        rel="noopener"
        class="glow-button rounded-md px-4 py-2 text-sm">Play Cambria</a
      >
    </div>
  </div>
</header>
